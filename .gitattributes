# 统一 Git 属性
* text=auto

# 文本文件统一 LF 换行
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.qrc text eol=lf
*.spec text eol=lf
*.txt text eol=lf

# 二进制文件
*.png binary
*.ico binary
*.icns binary
*.docx binary
*.db binary

# GitHub 自动生成的源码归档（zip/tar）中排除构建脚本
/build.py export-ignore
/MESLogRelay.spec export-ignore
